{
  "name": "route-atlas",
  "displayName": "Route Atlas",
  "description": "Universal project intelligence and one-click security checks for VS Code.",
  "version": "0.4.1",
  "publisher": "t1m0ntimon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/T1m0nTimon/route-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/T1m0nTimon/route-atlas/issues"
  },
  "homepage": "https://github.com/T1m0nTimon/route-atlas#readme",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Testing",
    "Linters",
    "Other"
  ],
  "keywords": [
    "routes",
    "endpoints",
    "sitemap",
    "api",
    "openapi",
    "broken links",
    "curl",
    "typescript",
    "cli",
    "flask",
    "nextjs",
    "express",
    "django",
    "laravel"
  ],
  "main": "./src/extension.js",
  "bin": {
    "route-atlas": "bin/route-atlas.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node --test test/scanner.test.js test/features.test.js test/links.test.js test/tools.test.js test/cli.test.js test/laravel-runtime.test.js test/universal-security.test.js test/sarif.test.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Addresses, headers, custom patterns and the route helpers file from an untrusted workspace are ignored. Security scans are read-only and do not execute project code.",
      "restrictedConfigurations": [
        "routeAtlas.baseUrl",
        "routeAtlas.requestHeaders",
        "routeAtlas.categories",
        "routeAtlas.ignoreLinks",
        "routeAtlas.helpersFile",
        "routeAtlas.laravelRuntime",
        "routeAtlas.laravelRuntimeExecutable",
        "routeAtlas.laravelRuntimeArgs"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "routeAtlas",
          "title": "Route Atlas",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "routeAtlas": [
        {
          "id": "routeAtlas.routes",
          "name": "Routes",
          "icon": "media/activity.svg"
        },
        {
          "id": "routeAtlas.security",
          "name": "Security",
          "icon": "$(shield)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "routeAtlas.routes",
        "contents": "Open a folder to see its routes.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "routeAtlas.routes",
        "contents": "No routes found in this project.\n[Search again](command:routeAtlas.refresh)",
        "when": "workbenchState != empty && routeAtlas.empty"
      },
      {
        "view": "routeAtlas.security",
        "contents": "## Project security\n\nScan this project for common security risks. The scan is local and read-only.\n\n[Start security scan](command:routeAtlas.securityScan)",
        "when": "workbenchState != empty"
      }
    ],
    "commands": [
      {
        "command": "routeAtlas.search",
        "title": "Find a Route",
        "category": "Route Atlas",
        "icon": "$(search)"
      },
      {
        "command": "routeAtlas.groupBy",
        "title": "Group Routes By...",
        "category": "Route Atlas",
        "icon": "$(list-tree)"
      },
      {
        "command": "routeAtlas.checkAll",
        "title": "Check All Routes",
        "category": "Route Atlas",
        "icon": "$(pulse)"
      },
      {
        "command": "routeAtlas.export",
        "title": "Export Routes...",
        "category": "Route Atlas",
        "icon": "$(export)"
      },
      {
        "command": "routeAtlas.setServer",
        "title": "Set Server Address",
        "category": "Route Atlas",
        "icon": "$(server)"
      },
      {
        "command": "routeAtlas.refresh",
        "title": "Search Again",
        "category": "Route Atlas",
        "icon": "$(refresh)"
      },
      {
        "command": "routeAtlas.filter",
        "title": "Filter Routes",
        "category": "Route Atlas",
        "icon": "$(filter)"
      },
      {
        "command": "routeAtlas.clearFilter",
        "title": "Clear Filter",
        "category": "Route Atlas",
        "icon": "$(filter-filled)"
      },
      {
        "command": "routeAtlas.open",
        "title": "Open File",
        "category": "Route Atlas"
      },
      {
        "command": "routeAtlas.browser",
        "title": "Open in Browser",
        "category": "Route Atlas",
        "icon": "$(globe)"
      },
      {
        "command": "routeAtlas.send",
        "title": "Send Request",
        "category": "Route Atlas",
        "icon": "$(play)"
      },
      {
        "command": "routeAtlas.favorite",
        "title": "Add to Favorites",
        "category": "Route Atlas",
        "icon": "$(star-empty)"
      },
      {
        "command": "routeAtlas.unfavorite",
        "title": "Remove from Favorites",
        "category": "Route Atlas",
        "icon": "$(star-full)"
      },
      {
        "command": "routeAtlas.copyPath",
        "title": "Copy Path",
        "category": "Route Atlas"
      },
      {
        "command": "routeAtlas.copyUrl",
        "title": "Copy Address",
        "category": "Route Atlas"
      },
      {
        "command": "routeAtlas.copyAs",
        "title": "Copy as cURL, fetch, Axios...",
        "category": "Route Atlas"
      },
      {
        "command": "routeAtlas.generateHelpers",
        "title": "Generate TypeScript Route Helpers",
        "category": "Route Atlas",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "routeAtlas.securityScan",
        "title": "Start Security Scan",
        "category": "Route Atlas",
        "icon": "$(shield)"
      },
      {
        "command": "routeAtlas.dashboard",
        "title": "Open Project Dashboard",
        "category": "Route Atlas",
        "icon": "$(dashboard)"
      },
      {
        "command": "routeAtlas.exportSecuritySarif",
        "title": "Export Security Findings as SARIF",
        "category": "Route Atlas",
        "icon": "$(export)"
      }
    ],
    "keybindings": [
      {
        "command": "routeAtlas.search",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "routeAtlas.search",
          "when": "view == routeAtlas.routes",
          "group": "navigation@1"
        },
        {
          "command": "routeAtlas.filter",
          "when": "view == routeAtlas.routes && !routeAtlas.filtered",
          "group": "navigation@2"
        },
        {
          "command": "routeAtlas.clearFilter",
          "when": "view == routeAtlas.routes && routeAtlas.filtered",
          "group": "navigation@2"
        },
        {
          "command": "routeAtlas.groupBy",
          "when": "view == routeAtlas.routes",
          "group": "navigation@3"
        },
        {
          "command": "routeAtlas.checkAll",
          "when": "view == routeAtlas.routes",
          "group": "navigation@4"
        },
        {
          "command": "routeAtlas.export",
          "when": "view == routeAtlas.routes",
          "group": "1_tools@1"
        },
        {
          "command": "routeAtlas.setServer",
          "when": "view == routeAtlas.routes",
          "group": "1_tools@2"
        },
        {
          "command": "routeAtlas.generateHelpers",
          "when": "view == routeAtlas.routes",
          "group": "1_tools@2"
        },
        {
          "command": "routeAtlas.refresh",
          "when": "view == routeAtlas.routes",
          "group": "1_tools@3"
        },
        {
          "command": "routeAtlas.securityScan",
          "when": "view == routeAtlas.security",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "routeAtlas.send",
          "when": "view == routeAtlas.routes && viewItem =~ /^(route|endpoint)/",
          "group": "inline@1"
        },
        {
          "command": "routeAtlas.browser",
          "when": "view == routeAtlas.routes && viewItem =~ /^route/",
          "group": "inline@2"
        },
        {
          "command": "routeAtlas.send",
          "when": "view == routeAtlas.routes && viewItem =~ /^(route|endpoint)/",
          "group": "1_open@1"
        },
        {
          "command": "routeAtlas.browser",
          "when": "view == routeAtlas.routes && viewItem =~ /^route/",
          "group": "1_open@2"
        },
        {
          "command": "routeAtlas.favorite",
          "when": "view == routeAtlas.routes && viewItem =~ /^(route|endpoint)$/",
          "group": "2_favorite"
        },
        {
          "command": "routeAtlas.unfavorite",
          "when": "view == routeAtlas.routes && viewItem =~ /\\.favorite$/",
          "group": "2_favorite"
        },
        {
          "command": "routeAtlas.copyPath",
          "when": "view == routeAtlas.routes && viewItem =~ /^(route|endpoint)/",
          "group": "3_copy@1"
        },
        {
          "command": "routeAtlas.copyUrl",
          "when": "view == routeAtlas.routes && viewItem =~ /^(route|endpoint)/",
          "group": "3_copy@2"
        },
        {
          "command": "routeAtlas.copyAs",
          "when": "view == routeAtlas.routes && viewItem =~ /^(route|endpoint)/",
          "group": "3_copy@3"
        }
      ],
      "commandPalette": [
        {
          "command": "routeAtlas.open",
          "when": "false"
        },
        {
          "command": "routeAtlas.browser",
          "when": "false"
        },
        {
          "command": "routeAtlas.send",
          "when": "false"
        },
        {
          "command": "routeAtlas.favorite",
          "when": "false"
        },
        {
          "command": "routeAtlas.unfavorite",
          "when": "false"
        },
        {
          "command": "routeAtlas.copyPath",
          "when": "false"
        },
        {
          "command": "routeAtlas.copyUrl",
          "when": "false"
        },
        {
          "command": "routeAtlas.copyAs",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Route Atlas",
      "properties": {
        "routeAtlas.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Address of the running server, for example `http://127.0.0.1:8080`. Empty: looks for a running server on `PORT` from `.env`, the framework's default port and common ports."
        },
        "routeAtlas.requestHeaders": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Headers sent with every request, for example `{ \"Authorization\": \"Bearer ...\" }`. Keep tokens in your user settings, not in a committed workspace file."
        },
        "routeAtlas.categories": {
          "type": "array",
          "default": [],
          "markdownDescription": "Your own categories, they win over the built-in ones. Example: `{ \"label\": \"Shop\", \"pattern\": \"^/(shop|cart)\", \"icon\": \"tag\" }`",
          "items": {
            "type": "object",
            "required": [
              "label",
              "pattern"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "pattern": {
                "type": "string",
                "description": "Regular expression for the path"
              },
              "icon": {
                "type": "string",
                "description": "Name of a codicon"
              }
            }
          }
        },
        "routeAtlas.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "More folder names to skip."
        },
        "routeAtlas.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show a send button above each route in the code."
        },
        "routeAtlas.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Report routes handled twice and admin routes without a login check in the Problems panel."
        },
        "routeAtlas.brokenLinks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Report links such as `href=\"/x\"`, `fetch(\"/api/x\")` or `redirect(\"/x\")` that no route answers. Needs `#routeAtlas.diagnostics#`."
        },
        "routeAtlas.ignoreLinks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Regular expressions for paths that are never reported as broken, for example `^/api/` when the API runs in another project."
        },
        "routeAtlas.helpersFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Keep TypeScript route helpers in this file up to date, for example `src/routes.gen.ts`. The path is relative to the workspace folder. Empty: only on demand."
        },
        "routeAtlas.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "de"
          ],
          "default": "auto",
          "description": "Language of the view. Auto follows the editor and the system."
        },
        "routeAtlas.laravelRuntime": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run `php artisan route:list --json` to include dynamically registered Laravel routes. This boots the project and may execute service providers or connect to configured services. Enable only for a trusted project."
        },
        "routeAtlas.laravelRuntimeExecutable": {
          "type": "string",
          "default": "php",
          "markdownDescription": "Executable used for Laravel runtime scanning. For Docker, use `docker` and configure `routeAtlas.laravelRuntimeArgs`."
        },
        "routeAtlas.laravelRuntimeArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "artisan",
            "route:list",
            "--json"
          ],
          "markdownDescription": "Arguments passed to the Laravel runtime executable without a shell. Docker example: `[\"exec\", \"-w\", \"/var/www/html\", \"nova-pelican-panel\", \"php\", \"artisan\", \"route:list\", \"--json\"]`."
        }
      }
    }
  }
}
